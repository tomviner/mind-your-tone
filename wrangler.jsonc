{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mind-your-tone-python",
  "main": "./worker/main.py",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "jev-tone.tomv.uk",
      "custom_domain": true
    }
  ],
  "find_additional_modules": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.json"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
